      "author": "yd",
      "licence": "CC0",
      "source": "https://opengameart.org/content/insistent-background-loop"
    },
    {
      "title": "Win Jingle",
      "author": "Fupi",
      "licence": "CC0",
      "source": "https://opengameart.org/content/win-jingle"
    }
  ]
